# SIGIA-CEMINSA — Variables de entorno
# Copiar como .env y completar valores locales

DATABASE_URL="postgresql://sigia_user:change_me@localhost:5432/sigia_ceminsa"
POSTGRES_USER=sigia_user
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=sigia_ceminsa
POSTGRES_PORT=5432

BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=change_me_generate_with_openssl
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

NEXT_PUBLIC_API_URL=http://localhost:3001/api

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET_DOCUMENTS=sigia-documents
